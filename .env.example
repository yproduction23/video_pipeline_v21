# ──────────────────────────────────────────────────────────
# Video Pipeline - Local Environment Variables Configuration
# ──────────────────────────────────────────────────────────

# [필수] 실제 값은 저장소 루트 .env에만 설정합니다.
SPRING_DATASOURCE_PASSWORD=
APP_SECRET_KEY=
# 신규 DB에서 최초 admin 계정을 만들 때만 사용합니다.
ADMIN_SEED_PASSWORD=

# [CRITICAL] Anthropic API Key for 3-Round Fact-Checking & Claude Sonnet script generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# [Optional] YouTube Data API v3 key for keyword/video evidence search
YOUTUBE_API_KEY=

# [Optional] Market Data Collector APIs
FINNHUB_API_KEY=
FRED_API_KEY=
DART_API_KEY=
# NAVER API HUB 뉴스 검색·검색어 트렌드. true로 켜면 두 키가 모두 필수입니다.
NAVER_API_HUB_ENABLED=false
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
ARTICLE_EVIDENCE_AUTO_ENABLED=true
EVIDENCE_MAX_SCENES=12
EVIDENCE_MAX_SEARCHES_PER_SCENE=3
EVIDENCE_MIN_SENTENCE_SIMILARITY=0.85

# [Optional] Premium Voice Narration
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=dlKJ5VptCbYxal4doUO5
# Eleven v3 enables Korean language_code and IPA-capable pronunciation dictionaries.
ELEVENLABS_TTS_MODEL=eleven_v3
TTS_MODEL_INTRO=eleven_v3
TTS_MODEL_BODY=eleven_v3
TTS_STABILITY_INTRO=0.5
TTS_STABILITY_BODY=0.5
TTS_CER_THRESHOLD=0.05
TTS_DURATION_TOLERANCE=0.25

# [Optional] Premium Kling AI Motion Video Generation
KLING_API_KEY=

# [Optional] OpenAI Images API. 2026-09-29~10-01 기간 한시적으로 메인이었으나,
# Gemini 결제 복구 후 다시 보류(fallback) 공급자다.
OPENAI_API_KEY=
# gemini(기본) / openai / fal. 실패 시 gemini -> fal -> openai 순으로 대체한다.
IMAGE_PROVIDER=gemini

# [Optional] Gemini API Key
GEMINI_API_KEY=
# still_image_pilot=true 테스트에서만 적용되는 Gemini 이미지 생성 상한(원)입니다.
# 실제 롱폼 영상의 4만원/7만원 총비용 상한에는 영향을 주지 않습니다.
GEMINI_TEST_IMAGE_BUDGET_KRW=5000

# [Optional] V5 BFL FLUX image generation. Never commit a real key.
# 실제 BFL 생성만 V5_BFL_ENABLED=true로 켜며, 키 값은 로그에 남기지 않습니다.
BFL_API_KEY=
V5_BFL_ENABLED=false
# P0 검증용 수동 환율입니다. 운영에서는 빈 값으로 두고 승인된 환율 API/캐시를 연결합니다.
FX_USD_KRW=
# NanumGothicBold 등 한글 글꼴의 절대 경로. 미설정이면 V5는 한글 오버레이를 건너뜁니다.
KOREAN_FONT_PATH=
# 참조 채널명 대신 사용할 자체 로고 문구입니다.
CHANNEL_LOGO_TEXT=경제브리핑
# P1-b Gemini 비교 실행 전, 콘솔의 현재 계약 단가를 승인자가 입력합니다.
# Gemini 응답에는 청구 실비가 없으므로 빈 값이면 V5 비용 사전승인을 중단합니다.
V5_GEMINI_PRO_IMAGE_2K_ESTIMATE_USD=
V5_GEMINI_FLASH_IMAGE_2K_ESTIMATE_USD=
# Immediate video jobs use synchronous Pro generation. Batch is reserved for
# explicitly selected economy rendering. It is never an interactive fallback.
GEMINI_PRO_BATCH_ENABLED=false
GEMINI_PRO_BATCH_FALLBACK_ENABLED=false
# 운영 이미지 경로는 실측 검증된 Pro Priority를 기본으로 사용합니다.
# 응답의 x-gemini-service-tier가 standard로 강등되면 감사 원장에 별도 기록됩니다.
GEMINI_SERVICE_TIER=priority

# Korean ElevenLabs narration: 1.25x, based on measured
# narration characters (not visual-prompt text).
TTS_SPEED=0.9
TTS_SENTENCE_PAUSE_MS=350
TTS_PARAGRAPH_PAUSE_MS=400
CHARS_PER_MINUTE=400

# Direct Gemini Pro 2K reliability. Batch remains disabled for interactive jobs.
GEMINI_PRO_MAX_ATTEMPTS=5
GEMINI_PRO_RETRY_BASE_SECONDS=20
GEMINI_PRO_REQUEST_DELAY_SECONDS=3
GEMINI_PARALLEL_ENABLED=true
GEMINI_MAX_CONCURRENCY=1
GEMINI_RETRY_MAX=4
GEMINI_RPM_SOFT_CAP=6
GEMINI_ADAPTIVE_BACKOFF_ENABLED=true
IMAGE_SAME_ERROR_BREAK_COUNT=1
LONGFORM_SCENE_MAX_WORKERS=2
# 이미지 생성은 Gemini Pro 2K만 사용합니다. Flash/hybrid 자동 전환은 허용하지 않습니다.
IMAGE_QUALITY_TIER=pro
# Replace these placeholder rates with the current AI Studio/Fal console rates
# before a production run. The preflight includes its own retry buffer.
IMG_COST_FLASH_1K_USD=0.045
IMG_COST_FLASH_2K_USD=0.101
IMG_COST_PRO_2K_USD=0.134
IMG_COST_PRO_PRIORITY_2K_USD=0.24192
KLING_COST_PER_CLIP_USD=0.35
USD_KRW=1400
MAX_BUDGET_PER_VIDEO_KRW=70000
BUDGET_RETRY_BUFFER_PCT=10
# Kling은 시작 시점부터 아래 초 단위 끝 지점까지만 적용합니다.
# 영상 길이가 600초 이하이면 0~45초, 초과하면 0~60초가 기본입니다.
# 5초 단위 장면만 선택하며 검증 수치 오버레이 장면과 후반 장면은 제외됩니다.
INTRO_MOTION_ENABLED=true
INTRO_MOTION_SECONDS_SHORT=45
INTRO_MOTION_SECONDS_LONG=60
INTRO_MOTION_SHORT_THRESHOLD=600
INTRO_MOTION_CLIP_COUNT=12
INTRO_MOTION_CLIP_SECONDS=5
INTRO_MOTION_TEST_MODE=false
ANTHROPIC_PROMPT_CACHE_ENABLED=true
ANTHROPIC_PROMPT_CACHE_TTL=5m

# Evidence overlays are generated after image/video creation.  No Korean text
# or exact financial numbers are sent into image-generation prompts.
RENDER_SPEECH_BUBBLES=false
RENDER_ARTICLE_EVIDENCE=true
THUMBNAIL_V2_ENABLED=false
THUMBNAIL_HEADLINE_MAX_LINES=4
THUMBNAIL_HEADLINE_MIN_FONT_PX=64
ARTICLE_ALLOWED_PUBLISHERS_ONLY=true
SCENE_REVEAL_ENABLED=true
BUBBLE_FONT_MAX_PX=96
BUBBLE_FONT_MIN_PX=60
SUBTITLE_SAFE_AREA_PCT=21
# Gemini Pro 2K 참조 이미지 생성은 120초를 넘길 수 있어 읽기 제한을 별도로 둔다.
GEMINI_PRO_REQUEST_TIMEOUT_SECONDS=300
GEMINI_PRO_SERVER_TIMEOUT_SECONDS=285
GEMINI_IMAGE_SERVER_TIMEOUT_SECONDS=150
